{
  "name": "@qozara/cloud-sync-google",
  "version": "1.0.0",
  "description": "Google Drive and Google Sheets cloud synchronization drivers and provider for @qozara/cloud-sync.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qozara/cloud-sync.git",
    "directory": "packages/google"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "check": "tsc --noEmit -p ../../tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@qozara/cloud-sync": "^1.0.0",
    "@qozara/gdocs-schema": "^1.3.0"
  },
  "license": "MIT"
}
